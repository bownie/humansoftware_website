---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";

const { site } = config;
const { titleOverride }: { titleOverride?: string } = Astro.props;
const headerTitle = titleOverride ?? site.shortTitle ?? site.title;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout humansoftware-header">
  <div class="humansoftware-header-inner">
    <div class="humansoftware-header-left">
      <button
        id="theme-btn"
        type="button"
        class="humansoftware-header-theme"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <IconSunHigh
          class="humansoftware-header-icon humansoftware-header-icon-sun"
        />
        <IconMoon
          class="humansoftware-header-icon humansoftware-header-icon-moon"
        />
      </button>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        data-astro-reload
        class="humansoftware-header-title">{headerTitle}</a
      >
    </div>
    <nav class="humansoftware-header-nav" aria-label="Main navigation">
      <a
        href={getRelativeLocaleUrl(locale, "story")}
        class="humansoftware-header-link">Story</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "praise")}
        class="humansoftware-header-link">{t.nav.praise}</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class="humansoftware-header-link">{t.nav.about}</a
      >
      <a
        href={`${getRelativeLocaleUrl(locale, "")}#join`}
        data-astro-reload
        class="humansoftware-header-link">Newsletter</a
      >
      <a
        href={`${getRelativeLocaleUrl(locale, "")}#buy`}
        class="humansoftware-header-buy">Get the book</a
      >
    </nav>
  </div>
</header>
