---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose humansoftware-about">
    <div class="about-author-grid">
      <img
        src={getAssetPath("richardwbown-london-rooftop-square-reduced.jpg")}
        alt="Richard W. Bown on a rooftop in London"
        class="about-author-image"
      />
      <div class="about-author-copy">
        <Content />
      </div>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  .about-author-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 5vw, 3rem);
    max-width: none;
  }

  .about-author-image {
    width: min(100%, 280px);
    margin: 0 auto !important;
  }

  .about-author-copy > :first-child {
    margin-top: 0;
  }

  @media (max-width: 600px) {
    .about-author-grid {
      grid-template-columns: 1fr;
    }

    .about-author-image {
      width: min(100%, 240px);
    }
  }
</style>
