---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";

const pageTitle = "Human Software: Where Would You Draw the Line?";
const pageDescription =
  "A novel about work, technology and the human cost of the decisions companies make.";
---

<Layout title={`${pageTitle} | Human Software`} description={pageDescription}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={pageTitle}
    pageDesc={pageDescription}
    class="humansoftware-about book-overview"
  >
    <section class="book-overview-hero" aria-label="About the novel">
      <img
        class="book-overview-cover"
        src={getAssetPath("human-software-cover-v4.png")}
        alt="Human Software by Richard W. Bown"
      />
      <div>
        <p>
          <em>Human Software</em> is a novel that illustrates the delicate relationship
          between IT workers and their employers. It shows how smart, intrinsically
          curious and self-motivated people can be driven to burnout by long hours
          and overwork. It also shows how strictly hierarchical organisations, accommodating
          governments and local authorities, can make decisions that affect not only
          employees but also their families and local and natural environment through
          technical projects such as data centres and AI usage.
        </p>
        <p>
          Set in the decaying English port town of Sandport, the story follows
          Beth Walters, an exhausted software engineer nursing failing logistics
          systems through 3 a.m. support calls, and Chrissie Hegarty, an
          ambitious American executive sent to force through a massive AI
          overhaul. The narrative shifts from corporate satire into a
          high-stakes technothriller when a data leak leads to a murder
          investigation, revealing that the company is using AI to sabotage its
          own infrastructure and frame human employees.
        </p>
        <p>
          <em>Human Software</em> is centred on two women on opposite sides of a corporate
          collision course. As the company bets big on data centres and AI-driven
          “efficiency,” the two find they may have more common ground than either
          expected.
        </p>
      </div>
    </section>

    <p>
      As such, I’ve framed <em>Human Software</em> as a cross between
      <em>The Phoenix Project</em> and <em>Local Hero</em>. It’s a techie story
      with a moral.
    </p>
    <p class="book-overview-question">
      Should companies use data centres and AI to eliminate employees? Should
      employees always go the extra mile for their employers?
    </p>

    <section aria-labelledby="early-reader-reactions">
      <h2 id="early-reader-reactions">A few reactions from early readers</h2>
      <div class="book-overview-quotes">
        <blockquote>
          <p>“Freaked me out more than any Stephen King novel.”</p>
          <cite>Jeremy Markey, Rands Review</cite>
        </blockquote>
        <blockquote>
          <p>
            “A pacey thriller that throws us right into the maelstrom of the big
            issues we all face today.”
          </p>
          <cite>Verified Amazon reviewer</cite>
        </blockquote>
        <blockquote>
          <p>“Could scarcely be more of the moment.”</p>
          <cite>Charles Humble, Tech Consultant &amp; Journalist</cite>
        </blockquote>
      </div>
    </section>

    <p class="book-overview-author">
      Written by Richard W. Bown, a software engineer and DevOps practitioner
      with thirty years in the industry.
    </p>

    <section aria-labelledby="discussion-guide">
      <h2 id="discussion-guide">Free discussion guide</h2>
      <p>
        There’s a free book club discussion guide to go with it — icebreakers,
        themed questions and workshop prompts built around specific scenes.
        Useful whether you’re reading this with your actual book club or getting
        your team to argue about it over lunch.
      </p>
      <a
        class="book-overview-button"
        href={getAssetPath("book-assets/book-club-guide.pdf")}
        >Download the guide</a
      >
    </section>

    <section aria-labelledby="bulk-copies">
      <h2 id="bulk-copies">Bulk copies for teams and book clubs</h2>
      <p>
        Copies are available at a discount for groups of 5 or more,
        first-edition cover included, while stock lasts. The discussion guide
        comes free with every order.
      </p>
      <a
        class="book-overview-button book-overview-button-secondary"
        href="/contact-me/">Enquire for bulk pricing</a
      >
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  .book-overview-hero {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
    max-width: none;
    margin-bottom: 2rem;
  }

  .book-overview-hero .book-overview-cover {
    width: min(100%, 250px);
    margin: 0 auto;
  }

  .book-overview-hero p:first-child {
    margin-top: 0;
  }

  .book-overview-question {
    color: var(--foreground) !important;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
  }

  .book-overview-quotes {
    display: grid;
    gap: 1rem;
  }

  .book-overview-quotes blockquote {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
    padding: 1.25rem;
  }

  .book-overview-quotes blockquote p {
    margin: 0;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.2rem;
    font-style: italic;
  }

  .book-overview-quotes cite {
    display: block;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    font-style: normal;
  }

  .book-overview-author {
    margin-top: 2rem;
  }

  .book-overview-button {
    display: inline-block;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-foreground) !important;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .book-overview-button:hover {
    filter: brightness(0.95);
  }

  .book-overview-button-secondary {
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground) !important;
  }

  @media (min-width: 700px) {
    .book-overview-quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .book-overview-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
