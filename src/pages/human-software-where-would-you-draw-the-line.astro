---
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const storyUrl = getAssetPath("story/");
---

<!doctype html>
<html lang={config.site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${storyUrl}`} />
    <link rel="canonical" href={new URL(storyUrl, Astro.site)} />
    <title>Read the story</title>
  </head>
  <body data-pagefind-ignore>
    <p>The story has moved to <a href={storyUrl}>its new page</a>.</p>
  </body>
</html>
