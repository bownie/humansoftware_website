---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout island-home"
  >
    <section class="island-hero" aria-labelledby="hero-title">
      <img src={getAssetPath("contours.svg")} alt="" class="island-contours" />
      <div class="island-hero-grid">
        <div>
          <p class="island-eyebrow">A novel by Richard W. Bown</p>
          <h1 id="hero-title"><em>Human Software</em></h1>
          <p class="island-subtitle">
            Richard W. Bown's debut novel, published in 2025.
          </p>
          <a
            class="island-button bg-accent text-accent-foreground inline-block rounded-full px-6 py-3 font-bold"
            href="https://humansoftwarebook.com">Discover the book</a
          >
        </div>
        <img
          src={getAssetPath("human-software-cover-v4.png")}
          alt="Human Software book cover"
          class="island-cover"
        />
      </div>
    </section>

    <section class="py-16 sm:py-20" aria-labelledby="story-title">
      <div class="island-story">
        <h2 id="story-title" class="sr-only">About Human Software</h2>
        <p class="lead">
          <b>Human Software</b> is Richard W. Bown's debut novel, published in 2025.
        </p>
        <p>
          Discover the book and learn more at <a
            href="https://humansoftwarebook.com">humansoftwarebook.com</a
          >.
        </p>
      </div>
    </section>

    <section
      id="join"
      class="island-signup mb-16 sm:mb-20"
      aria-label="Newsletter signup"
    >
      <NewsletterSignup
        title="Sign up to stay informed"
        description="Join my newsletter for writing updates and news about my books."
      />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
