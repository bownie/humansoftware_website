---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout humansoftware-home"
  >
    <section class="humansoftware-hero" aria-labelledby="hero-title">
      <img
        src={getAssetPath("contours.svg")}
        alt=""
        class="humansoftware-contours"
      />
      <div class="humansoftware-hero-grid">
        <div>
          <p class="humansoftware-eyebrow">WELCOME TO SANDPORT</p>
          <h1 id="hero-title">Meet Beth and Chrissie</h1>
          <p class="humansoftware-subtitle">
            <em>Beth Walters</em> is the on-call engineer who's spent years trying to make 
            broken systems work. Despite support from friends and colleagues, juggling work
            and family life is tough and she knows things will change with the arrival of a new boss.
          </p>
          <p class="humansoftware-subtitle">
            <em>Chrissie Hegarty</em> is the American executive on a mission to
            improve efficiency. Ambitious and eager to make an impact, she will instead learn what it
            means to make truly life or death decisions.
          </p>
          <a
            class="humansoftware-button bg-accent text-accent-foreground inline-block rounded-full px-6 py-3 font-bold"
            href="#buy">Get the book</a
          >
        </div>
        <img
          src={getAssetPath("human-software-cover-v4.png")}
          alt="Human Software book cover"
          class="humansoftware-cover"
        />
      </div>
    </section>

    <section class="humansoftware-story-section" aria-labelledby="story-title">
      <div class="humansoftware-story">
        <p class="humansoftware-eyebrow">Software runs our world. It doesn’t rule our lives</p>
        <h2 id="story-title">The Systems are Human</h2>
        <p>
          Sandport isn't just another line on a spreadsheet. It's a English port town
          full of people whose lives depend on their work, no matter how difficult or
          distasteful they find it.
        </p>

        <p>
          Chrissie knows that she has a struggle on her hands from the moment the plane touches down.
          The town is in decline, the local workforce is aging, expensive and will likely oppose her
          plan every step of the way. 
        </p>

        <p>
          Set on the Kentish coast, <em>Human Software</em> explores relationship between
          work and home, the inevitable progress of technology and the choices people face
          when the world around them begin to change.
        </p>
        <a
          class="humansoftware-text-link"
          href={getRelativeLocaleUrl(locale, "praise")}
        >
          See what readers are saying
        </a>
      </div>
    </section>

    <section id="buy" class="humansoftware-buy" aria-labelledby="buy-title">
      <p class="humansoftware-eyebrow">Paperback, ebook and audiobook</p>
      <h2 id="buy-title">Get <em>Human Software</em></h2>
      <p class="humansoftware-buy-intro">
        Choose your preferred format and bookseller.
      </p>
      <div class="humansoftware-format-grid">
        <article class="humansoftware-format">
          <h3>Paperback</h3>
          <p>306 pages · includes a map of Kent and the Isle of Thanet</p>
          <p class="humansoftware-price">£10.99 / €11.99 / $12.99</p>
          <div class="humansoftware-retailer-links">
            <a
              href="https://www.waterstones.com/book/human-software/richard-william-bown/9789083469225"
              target="_blank"
              rel="noreferrer">Waterstones</a
            >
            <a
              href="https://www.amazon.com/dp/B0FSK1QTCS"
              target="_blank"
              rel="noreferrer">Amazon</a
            >
          </div>
        </article>
        <article class="humansoftware-format">
          <h3>Ebook</h3>
          <p>Available for Kindle and Kobo.</p>
          <div class="humansoftware-retailer-links">
            <a
              href="https://www.amazon.com/Human-Software-Life-I-T-Novel-ebook/dp/B0FR62MGWJ"
              target="_blank"
              rel="noreferrer">Kindle</a
            >
            <a
              href="https://www.kobo.com/gb/en/ebook/human-software-a-life-in-i-t-a-novel"
              target="_blank"
              rel="noreferrer">Kobo</a
            >
          </div>
        </article>
        <article class="humansoftware-format">
          <h3>Audiobook</h3>
          <p>Listen to <em>Human Software</em> on Apple Books.</p>
          <div class="humansoftware-retailer-links">
            <a
              href="https://books.apple.com/us/audiobook/human-software/id1860011324"
              target="_blank"
              rel="noreferrer">Apple Books</a
            >
          </div>
        </article>
      </div>
      <p class="humansoftware-local-bookshop">
        Prefer to shop locally? Ask your bookshop to order it using ISBN
        <strong>9789083469225</strong>.
      </p>
    </section>

    <section
      id="join"
      class="humansoftware-signup mb-16 sm:mb-20"
      aria-label="Newsletter signup"
    >
      <NewsletterSignup
        title="Sign up to stay informed"
        description="Join my newsletter for writing updates and news about my books."
      />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
