---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");
const storyUrl = getRelativeLocaleUrl(locale, "story");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout humansoftware-home"
  >
    <section class="humansoftware-hero" aria-labelledby="hero-title">
      <img
        src={getAssetPath("contours.svg")}
        alt=""
        class="humansoftware-contours"
      />
      <div class="humansoftware-hero-grid">
        <div>
          <p class="humansoftware-eyebrow">WELCOME TO SANDPORT</p>
          <h1 id="hero-title">Meet Beth and Chrissie</h1>
          <p class="humansoftware-subtitle">
            <em>Beth Walters</em> keeps a failing logistics system running through
            night shifts while trying to hold her family life together.
          </p>
          <p class="humansoftware-subtitle">
            <em>Chrissie Hegarty</em> arrives from America to make the company more
            efficient. Her AI overhaul will force both women to decide what progress
            is worth.
          </p>
          <a
            class="humansoftware-button bg-accent text-accent-foreground inline-block rounded-full px-6 py-3 font-bold"
            href="#buy">Get the book</a
          >
          <a class="humansoftware-hero-sample" href="/prologue/">
            Read a sample
          </a>
        </div>
        <img
          src={getAssetPath("human-software-v4.jpg")}
          alt="Human Software book cover"
          class="humansoftware-cover"
        />
      </div>
    </section>

    <aside class="humansoftware-reader-reaction" aria-label="Reader reaction">
      <blockquote>
        <p>“Freaked me out more than any Stephen King novel.”</p>
        <cite>Jeremy Markey, Rands Review</cite>
      </blockquote>
      <a href={`${storyUrl}#reviews`}>Read more reviews</a>
    </aside>

    <section class="humansoftware-story-section" aria-labelledby="story-title">
      <article class="humansoftware-story-card">
        <p class="humansoftware-eyebrow">
          Software runs our world. It doesn’t rule our lives
        </p>
        <h2 id="story-title">
          When a company’s AI overhaul threatens a town’s livelihoods, how far
          will its people go to protect one another?
        </h2>
        <p>
          In Sandport, software engineer Beth Walters keeps a failing logistics
          system running through punishing night shifts.
        </p>
        <p>
          Chrissie Hegarty arrives from America with a sweeping AI overhaul that
          could make Beth and her colleagues redundant. Then a data leak and a
          murder investigation reveal a plan to use AI to sabotage the company’s
          own systems and frame its employees. Beth and Chrissie must decide
          what they owe the company — and the people caught in its plans.
        </p>
        <a class="humansoftware-text-link" href={storyUrl}> Read the story </a>
      </article>
    </section>

    <section id="buy" class="humansoftware-buy" aria-labelledby="buy-title">
      <img
        src={getAssetPath("contours.svg")}
        alt=""
        class="humansoftware-contours"
      />
      <div class="humansoftware-buy-heading">
        <p class="humansoftware-eyebrow">Paperback and ebook</p>
        <h2 id="buy-title">Choose your edition</h2>
      </div>
      <div class="humansoftware-buy-showcase">
        <figure class="humansoftware-buy-cover">
          <img
            src={getAssetPath("human-software-v4.jpg")}
            alt="Current cover of Human Software by Richard W. Bown"
            loading="lazy"
          />
        </figure>
        <figure class="humansoftware-buy-map">
          <img
            src={getAssetPath("human-software-kent-map.jpg")}
            alt="Illustrated map of Kent and the Isle of Thanet"
            loading="lazy"
          />
          <figcaption>Illustrated map included in both editions</figcaption>
        </figure>
      </div>
      <div class="humansoftware-format-grid">
        <article class="humansoftware-format">
          <p class="humansoftware-format-label">Print edition</p>
          <h3>Paperback</h3>
          <p class="humansoftware-price">£10.99 / €11.99 / $12.99</p>
          <p>306 pages · ISBN 9789083469225</p>
          <div class="humansoftware-retailer-links">
            <a
              href="https://www.waterstones.com/book/human-software/richard-william-bown/9789083469225"
              target="_blank"
              rel="noreferrer">Waterstones</a
            >
            <a
              href="https://www.amazon.com/dp/B0FSK1QTCS"
              target="_blank"
              rel="noreferrer">Amazon</a
            >
          </div>
        </article>
        <article class="humansoftware-format humansoftware-ebook-format">
          <p class="humansoftware-format-label">Digital edition</p>
          <h3>Ebook</h3>
          <p>Read on Kindle, Kobo and other ebook platforms.</p>
          <div class="humansoftware-retailer-links">
            <a
              href="https://www.amazon.com/Human-Software-Life-I-T-Novel-ebook/dp/B0FR62MGWJ"
              target="_blank"
              rel="noreferrer">Kindle</a
            >
            <a
              href="https://www.kobo.com/gb/en/ebook/human-software-a-life-in-i-t-a-novel"
              target="_blank"
              rel="noreferrer">Kobo</a
            >
          </div>
        </article>
      </div>
      <details class="humansoftware-more-retailers">
        <summary>More retailers and international editions</summary>
        <p>
          <strong>Paperback:</strong>
          <a
            href="https://www.barnesandnoble.com/w/human-software-richard-w-bown/1148349948?ean=9789083469225"
            target="_blank"
            rel="noreferrer">Barnes &amp; Noble</a
          >,
          <a
            href="https://www.bol.com/nl/nl/p/human-software-a-life-in-i-t-a-novel/9300000242451744/"
            target="_blank"
            rel="noreferrer">bol.com</a
          >,
          <a
            href="https://www.bruna.nl/engelse-boeken/human-software-9789083469225"
            target="_blank"
            rel="noreferrer">Bruna</a
          >,
          <a
            href="https://www.abebooks.com/Human-Software-Life-Novel-Bown-Richard/32320979408/bd"
            target="_blank"
            rel="noreferrer">AbeBooks</a
          >,
          <a
            href="https://www.powells.com/book/human-software-a-life-in-it---a-novel-9789083469225"
            target="_blank"
            rel="noreferrer">Powell’s</a
          >.
        </p>
        <p>
          <strong>Ebook:</strong> Find more international ebook retailers through
          <a
            href="https://books2read.com/humansoftware"
            target="_blank"
            rel="noreferrer">Books2Read</a
          >.
        </p>
      </details>
      <p class="humansoftware-local-bookshop">
        Prefer a local bookshop? Ask them to order the paperback using ISBN
        <strong>9789083469225</strong>.
      </p>
    </section>

    <details class="humansoftware-earlier-edition">
      <summary>Earlier edition · limited stock</summary>
      <div>
        <img
          src={getAssetPath("human-software-original-cover-bookshot.jpg")}
          alt="Paperback copy of the earlier Human Software edition with its original cover"
          loading="lazy"
        />
        <p>
          A limited number of earlier paperbacks with the original cover are
          available directly from Richard. Get in touch through the social links
          in the footer if you’d prefer one.
        </p>
      </div>
    </details>

    <aside class="humansoftware-reading-groups">
      <p>
        <a href={`${storyUrl}#reading-groups`}>
          For reading groups and teams
        </a>
      </p>
    </aside>

    <section
      id="join"
      class="humansoftware-signup mb-16 sm:mb-20"
      aria-label="Newsletter signup"
    >
      <NewsletterSignup
        title="Get news of the next book"
        description="Join my newsletter for writing updates and news about my books."
      />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
