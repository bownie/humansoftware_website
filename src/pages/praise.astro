---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const endorsements = [
  {
    quote: "Freaked me out more than any Stephen King novel.",
    name: "Jeremy Markey",
    source: "Rands Review",
  },
  {
    quote: "Could scarcely be more of the moment.",
    name: "Charles Humble",
    source: "Tech Consultant & Journalist",
  },
  {
    quote: "David versus Goliath in the age of AI. A real page-turner.",
    name: "Susanne Kaiser",
    source: "Tech Consultant",
  },
  {
    quote:
      "Vivid world-building and well-rounded characters. I found myself completely hooked.",
    name: "Russell McLean",
    source: "Emmy and BAFTA Award-Winning Producer",
  },
  {
    quote: "Absolutely gripping! A must-read.",
    name: "Lovdeep Pannu",
    source: "CTO, Epicenter",
  },
];

const longerReviews = [
  {
    name: "Jeremy Markey",
    source: "LinkedIn and Rands Slack Book Reviewer",
    quote:
      "Human Software is a genuine, heartfelt novel that lets us see what it might be like for technical teams when AI tools are introduced — and one I won’t forget anytime soon. The anxiety around AI and its negative implications are front and center. The characters, the events, the tension, the scenarios — all feel authentic. While normally that’s good news, Human Software felt a little too real.",
  },
  {
    name: "Charles Humble",
    source: "Tech Consultant & Journalist",
    quote:
      "A proper page turner — part thriller, part whodunnit and a fine dystopian parable. It makes serious points about generative AI, globalisation and dehumanisation at work whilst also being something you could happily read on a beach. As well as savouring the book, I suspect many readers will wince with recognition.",
  },
  {
    name: "Jan Hartman",
    source: "Lead Advisor, IT Strategy & Policy, Dutch Judiciary",
    quote:
      "A pacey thriller that throws us right into the maelstrom of the big issues we all face today. This book builds tension through to a powerful crescendo finale — a real page-turner, with sharp observational phrasing that pops off the page. An accomplished debut and a refreshing read.",
  },
];
---

<Layout
  title={`Reviews of Human Software | ${config.site.title}`}
  description="Read what reviewers and readers say about Human Software, a novel by Richard W. Bown."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Reviews"
    pageDesc="Short quotes and longer reviews from readers and reviewers."
    class="humansoftware-about"
  >
    <section aria-label="Selected reader quotes" class="praise-featured">
      {
        endorsements.map(endorsement => (
          <figure class="praise-card">
            <blockquote class="praise-card-summary">
              “{endorsement.quote}”
            </blockquote>
            <figcaption>
              <strong>{endorsement.name}</strong>
              {endorsement.source && <span> — {endorsement.source}</span>}
            </figcaption>
          </figure>
        ))
      }
    </section>

    <section aria-labelledby="longer-reviews-title" class="praise-section">
      <h2 id="longer-reviews-title">Read more</h2>
      <div class="praise-details">
        {
          longerReviews.map(review => (
            <details>
              <summary>
                Read more — {review.name} <span aria-hidden="true">+</span>
              </summary>
              <blockquote>“{review.quote}”</blockquote>
              <p class="praise-attribution">{review.source}</p>
            </details>
          ))
        }
      </div>
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  .praise-featured {
    display: grid;
    gap: 1rem;
  }

  .praise-card,
  .praise-details details {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
  }

  .praise-card {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .praise-card-summary {
    margin: 0;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    line-height: 1.4;
  }

  .praise-card figcaption,
  .praise-attribution {
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-family: "DM Sans", sans-serif;
    font-size: 0.95rem;
  }

  .praise-card figcaption strong,
  .praise-attribution strong {
    color: var(--foreground);
  }

  .praise-section {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .praise-section h2 {
    margin-bottom: 1.25rem;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
  }

  .praise-details blockquote {
    margin: 0;
  }

  .praise-details {
    display: grid;
    gap: 0.75rem;
  }

  .praise-details details {
    padding: 1rem 1.25rem;
  }

  .praise-details summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--foreground);
    font-weight: 600;
    cursor: pointer;
  }

  .praise-details details[open] summary span {
    transform: rotate(45deg);
  }

  .praise-details details > p {
    margin: 1rem 0 0;
  }

  .praise-details details blockquote {
    margin-top: 1rem;
  }

  .praise-details details > .praise-attribution {
    font-size: 0.9rem;
  }

  @media (min-width: 700px) {
    .praise-featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
