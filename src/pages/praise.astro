---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const endorsements = [
  {
    quote: "Freaked me out more than any Stephen King novel.",
    name: "Jeremy Markey",
    source: "Rands Review",
  },
  {
    quote: "Could scarcely be more of the moment.",
    name: "Charles Humble",
    source: "Tech Consultant & Journalist",
  },
  {
    quote:
      "Vivid world-building and well-rounded characters. I found myself completely hooked.",
    name: "Russell McLean",
    source: "Emmy and BAFTA Award-Winning Producer",
  },
  {
    quote: "Absolutely gripping! A must-read.",
    name: "Lovdeep Pannu",
    source: "CTO, Epicenter",
  },
  {
    quote:
      "A pacey thriller that hurls us into the maelstrom of our modern world.",
    name: "Verified Amazon Reviewer",
    source: "",
  },
  {
    quote: "David versus Goliath in the age of AI. A real page-turner.",
    name: "Susanne Kaiser",
    source: "Tech Consultant",
  },
];

const readerResponses = [
  {
    name: "Jeremy Markey",
    source: "LinkedIn and Rands Slack Book Reviewer",
    quote:
      "Human Software is a genuine, heartfelt novel that lets us see what it might be like for technical teams when AI tools are introduced — and one I won’t forget anytime soon. The anxiety around AI and its negative implications are front and center. The characters, the events, the tension, the scenarios — all feel authentic. While normally that’s good news, Human Software felt a little too real.",
  },
  {
    name: "Charles Humble",
    source: "Tech Consultant & Journalist",
    quote:
      "A proper page turner — part thriller, part whodunnit and a fine dystopian parable. It makes serious points about generative AI, globalisation and dehumanisation at work whilst also being something you could happily read on a beach. As well as savouring the book, I suspect many readers will wince with recognition.",
  },
  {
    name: "Russell McLean",
    source: "Emmy and BAFTA Award-Winning Producer",
    quote:
      "Even if you’re not in tech, this story pulls you in with its vivid world-building and well-rounded characters. I found myself completely hooked.",
  },
  {
    name: "Lovdeep Pannu",
    source: "CTO, Epicenter",
    quote:
      "In one way or another I can identify with all of the characters. There are valuable lessons here about the whole being greater than the sum of its parts. Human Software is a must-read for managers, leaders and developers — it reminds us that we’re just humans making tools, and how we treat each other while we do it is our own choice.",
  },
  {
    name: "Jan Hartman",
    source: "Lead Advisor, IT Strategy & Policy, Dutch Judiciary",
    quote:
      "A pacey thriller that throws us right into the maelstrom of the big issues we all face today. This book builds tension through to a powerful crescendo finale — a real page-turner, with sharp observational phrasing that pops off the page. An accomplished debut and a refreshing read.",
  },
  {
    name: "Susanne Kaiser",
    source: "Tech Consultant",
    quote:
      "A sharp, compelling novel about what happens when human values collide with profit-driven corporate change fuelled by AI. David versus Goliath in the age of AI.",
  },
];
---

<Layout
  title={`Praise for Human Software | ${config.site.title}`}
  description="Reader and reviewer responses to Human Software by Richard W. Bown."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Praise for Human Software"
    pageDesc="What readers and reviewers are saying about the novel."
    class="humansoftware-about"
  >
    <section aria-label="Selected reviews" class="praise-featured">
      {
        endorsements.map(endorsement => (
          <figure class="praise-card">
            <blockquote class="praise-card-summary">
              “{endorsement.quote}”
            </blockquote>
            <figcaption>
              <strong>{endorsement.name}</strong>
              {endorsement.source && <span> — {endorsement.source}</span>}
            </figcaption>
          </figure>
        ))
      }
    </section>

    <section aria-labelledby="reader-responses-title" class="praise-section">
      <h2 id="reader-responses-title">What readers are saying</h2>
      <div class="praise-responses">
        {
          readerResponses.map(response => (
            <article class="praise-response">
              <blockquote>“{response.quote}”</blockquote>
              <p class="praise-attribution">
                <strong>{response.name}</strong> — {response.source}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="longer-reviews-title" class="praise-section">
      <h2 id="longer-reviews-title">Longer reviews</h2>
      <div class="praise-details">
        {
          readerResponses
            .filter(({ name }) =>
              ["Charles Humble", "Jeremy Markey", "Jan Hartman"].includes(name)
            )
            .map(review => (
              <details>
                <summary>
                  {review.name}'s review <span aria-hidden="true">+</span>
                </summary>
                <blockquote>“{review.quote}”</blockquote>
                <p class="praise-attribution">{review.source}</p>
              </details>
            ))
        }
        <details>
          <summary>
            Amazon reader review <span aria-hidden="true">+</span>
          </summary>
          <blockquote>
            “I definitely didn’t ask if it was a horror story, while this novel
            wouldn’t be found in the horror section, it freaked me out more than
            any Steven King novel has.”
          </blockquote>
        </details>
      </div>
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  .praise-featured {
    display: grid;
    gap: 1rem;
  }

  .praise-card,
  .praise-response,
  .praise-details details {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
  }

  .praise-card {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .praise-card-summary {
    margin: 0;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-style: italic;
    line-height: 1.4;
  }

  .praise-card figcaption,
  .praise-attribution {
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-family: "DM Sans", sans-serif;
    font-size: 0.95rem;
  }

  .praise-card figcaption strong,
  .praise-attribution strong {
    color: var(--foreground);
  }

  .praise-section {
    margin-top: 3.5rem;
  }

  .praise-section h2 {
    margin-bottom: 1.25rem;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
  }

  .praise-responses {
    display: grid;
    gap: 1rem;
  }

  .praise-response {
    padding: 1.25rem;
  }

  .praise-response > p:first-child {
    margin: 0;
  }

  .praise-response blockquote,
  .praise-details blockquote {
    margin: 0;
  }

  .praise-response .praise-attribution {
    margin-bottom: 0;
  }

  .praise-details {
    display: grid;
    gap: 0.75rem;
  }

  .praise-details details {
    padding: 1rem 1.25rem;
  }

  .praise-details summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--foreground);
    font-weight: 600;
    cursor: pointer;
  }

  .praise-details details[open] summary span {
    transform: rotate(45deg);
  }

  .praise-details details > p {
    margin: 1rem 0 0;
  }

  .praise-details details > .praise-attribution {
    font-size: 0.9rem;
  }

  @media (min-width: 700px) {
    .praise-featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .praise-responses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
