---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";

const pageTitle = "Human Software: Where Would You Draw the Line?";
const pageDescription =
  "Discover the story of Beth Walters and Chrissie Hegarty, caught in a high-stakes fight over AI, work and the people behind the systems.";

const endorsements = [
  {
    quote: "Freaked me out more than any Stephen King novel.",
    name: "Jeremy Markey",
    source: "Rands Review",
  },
  {
    quote: "Could scarcely be more of the moment.",
    name: "Charles Humble",
    source: "Tech Consultant & Journalist",
  },
  {
    quote: "David versus Goliath in the age of AI. A real page-turner.",
    name: "Susanne Kaiser",
    source: "Tech Consultant",
  },
  {
    quote:
      "Vivid world-building and well-rounded characters. I found myself completely hooked.",
    name: "Russell McLean",
    source: "Emmy and BAFTA Award-Winning Producer",
  },
  {
    quote: "Absolutely gripping! A must-read.",
    name: "Lovdeep Pannu",
    source: "CTO, Epicenter",
  },
  {
    quote:
      "A pacey thriller that throws us right into the maelstrom of the big issues we all face today.",
    name: "Jan Hartman",
    source: "Lead Advisor, IT Strategy & Policy, Dutch Judiciary",
  },
];

const longerReviews = [
  {
    name: "Jeremy Markey",
    source: "LinkedIn and Rands Slack Book Reviewer",
    quote:
      "Human Software is a genuine, heartfelt novel that lets us see what it might be like for technical teams when AI tools are introduced — and one I won’t forget anytime soon. The anxiety around AI and its negative implications are front and center. The characters, the events, the tension, the scenarios — all feel authentic. While normally that’s good news, Human Software felt a little too real.",
  },
  {
    name: "Charles Humble",
    source: "Tech Consultant & Journalist",
    quote:
      "A proper page turner — part thriller, part whodunnit and a fine dystopian parable. It makes serious points about generative AI, globalisation and dehumanisation at work whilst also being something you could happily read on a beach. As well as savouring the book, I suspect many readers will wince with recognition.",
  },
  {
    name: "Jan Hartman",
    source: "Lead Advisor, IT Strategy & Policy, Dutch Judiciary",
    quote:
      "A pacey thriller that throws us right into the maelstrom of the big issues we all face today. This book builds tension through to a powerful crescendo finale — a real page-turner, with sharp observational phrasing that pops off the page. An accomplished debut and a refreshing read.",
  },
];
---

<Layout title={`${pageTitle} | Human Software`} description={pageDescription}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={pageTitle}
    pageDesc={pageDescription}
    class="humansoftware-about book-overview"
  >
    <section class="book-overview-hero" aria-label="About the novel">
      <img
        class="book-overview-cover"
        src={getAssetPath("human-software-v4.jpg")}
        alt="Human Software by Richard W. Bown"
      />
      <div>
        <p class="book-overview-question">
          When a company’s AI overhaul threatens a town’s livelihoods, how far
          will its people go to protect one another?
        </p>
        <p>
          In Sandport, software engineer Beth Walters keeps a failing logistics
          system running through punishing night shifts.
        </p>
        <p>
          Chrissie Hegarty arrives from America with a sweeping AI overhaul that
          could make Beth and her colleagues redundant. Then a data leak and a
          murder investigation reveal a plan to use AI to sabotage the company’s
          own systems and frame its employees. Beth and Chrissie must decide
          what they owe the company — and the people caught in its plans.
        </p>
      </div>
    </section>

    <section
      id="reviews"
      class="book-overview-reviews"
      aria-labelledby="reviews-title"
    >
      <h2 id="reviews-title">Reviews</h2>
      <div class="book-overview-quotes">
        {
          endorsements.map(endorsement => (
            <figure class="book-overview-quote">
              <blockquote>“{endorsement.quote}”</blockquote>
              <figcaption>
                <strong>{endorsement.name}</strong> — {endorsement.source}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <h3>Read more</h3>
      <div class="book-overview-long-reviews">
        {
          longerReviews.map(review => (
            <details>
              <summary>
                Read more — {review.name} <span aria-hidden="true">+</span>
              </summary>
              <blockquote>“{review.quote}”</blockquote>
              <p>{review.source}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="book-overview-book-club" aria-labelledby="reading-groups">
      <h2 id="reading-groups">For reading groups and teams</h2>
      <p>
        A free discussion guide with questions and workshop prompts exploring
        the human side of software.
      </p>
      <div class="book-overview-actions">
        <a
          class="book-overview-button"
          href={getAssetPath("book-assets/book-club-guide.pdf")}
        >
          Download the free discussion guide
        </a>
        <a
          class="book-overview-button book-overview-secondary-button"
          href="/book-club/"
        >
          Explore the engineering book club
        </a>
      </div>
      <p class="book-overview-bulk">
        Bulk orders of five or more are available at a discount, with the
        discussion guide included. Get in touch through the social links in the
        footer.
      </p>
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  .book-overview-hero {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
    max-width: none;
    margin-bottom: 2rem;
  }

  .book-overview-hero .book-overview-cover {
    width: min(100%, 250px);
    margin: 0 auto;
  }

  .book-overview-hero p:first-child {
    margin-top: 0;
  }

  .book-overview-hero p {
    margin-bottom: 1.25rem;
  }

  .book-overview-hero p:last-child {
    margin-bottom: 0;
  }

  .book-overview-hero > div > p:not(.book-overview-question) {
    color: var(--muted-foreground);
  }

  .book-overview-question {
    color: var(--foreground) !important;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
  }

  .book-overview-quotes {
    display: grid;
    width: 100%;
    gap: 1rem;
  }

  .book-overview-quote {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
    padding: 1.25rem;
  }

  .book-overview-quote blockquote {
    margin: 0;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.2rem;
    font-style: italic;
  }

  .book-overview-quote figcaption {
    display: block;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
  }

  .book-overview-quote figcaption strong {
    color: var(--foreground);
  }

  .book-overview-quote:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .book-overview-reviews h3 {
    margin: 2rem 0 1rem;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .book-overview-long-reviews {
    display: grid;
    gap: 0.75rem;
  }

  .book-overview-long-reviews details {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
    padding: 1rem 1.25rem;
  }

  .book-overview-long-reviews summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--foreground);
    font-weight: 600;
    cursor: pointer;
  }

  .book-overview-long-reviews details[open] summary span {
    transform: rotate(45deg);
  }

  .book-overview-long-reviews blockquote {
    margin: 1rem 0 0;
    color: var(--foreground);
  }

  .book-overview-long-reviews details > p {
    margin: 1rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.95rem;
  }

  .book-overview-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 999px;
    background: var(--accent);
    color: #13222a !important;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .book-overview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .book-overview-button:hover {
    filter: brightness(0.95);
  }

  .book-overview-secondary-button {
    border: 1px solid var(--accent);
    background: transparent;
    color: var(--foreground) !important;
  }

  .book-overview-bulk {
    margin: 2rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  @media (min-width: 700px) {
    .book-overview-quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .book-overview-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
