---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";

const pageTitle = "Human Software: Where Would You Draw the Line?";
const pageDescription =
  "Discover the story of Beth Walters and Chrissie Hegarty, caught in a high-stakes fight over AI, work and the people behind the systems.";
---

<Layout title={`${pageTitle} | Human Software`} description={pageDescription}>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={pageTitle}
    pageDesc={pageDescription}
    class="humansoftware-about book-overview"
  >
    <section class="book-overview-hero" aria-label="About the novel">
      <img
        class="book-overview-cover"
        src={getAssetPath("human-software-cover-v4.png")}
        alt="Human Software by Richard W. Bown"
      />
      <div>
        <p class="book-overview-question">
          When a company’s AI overhaul threatens a town’s livelihoods, how far
          will its people go to protect one another?
        </p>
        <p>
          In Sandport, software engineer Beth Walters keeps a failing logistics
          system running through punishing night shifts.
        </p>
        <p>
          Chrissie Hegarty arrives from America with a sweeping AI overhaul that
          could make Beth and her colleagues redundant. Then a data leak and a
          murder investigation reveal a plan to use AI to sabotage the company’s
          own systems and frame its employees. Beth and Chrissie must decide
          what they owe the company — and the people caught in its plans.
        </p>
      </div>
    </section>

    <section aria-labelledby="early-reader-reactions">
      <h2 id="early-reader-reactions">A reader’s reaction</h2>
      <div class="book-overview-quotes">
        <blockquote>
          <p>
            “A pacey thriller that throws us right into the maelstrom of the big
            issues we all face today.”
          </p>
          <cite>Jan Hartman, Lead Advisor, Dutch Judiciary</cite>
        </blockquote>
      </div>
    </section>

    <section class="book-overview-book-club" aria-labelledby="reading-groups">
      <h2 id="reading-groups">For reading groups and teams</h2>
      <p>
        A free discussion guide with questions and workshop prompts exploring
        the human side of software.
      </p>
      <a class="book-overview-button" href="/book-club/">
        Explore the engineering book club
      </a>
      <p class="book-overview-book-club-link">
        <a href={getAssetPath("book-assets/book-club-guide.pdf")}>
          Download the free discussion guide
        </a>
      </p>
      <p class="book-overview-bulk">
        Bulk orders of five or more are available at a discount, with the
        discussion guide included. Get in touch through the social links in the
        footer.
      </p>
    </section>
  </Main>
  <Footer />
</Layout>

<style>
  .book-overview-hero {
    display: grid;
    grid-template-columns: minmax(150px, 0.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
    max-width: none;
    margin-bottom: 2rem;
  }

  .book-overview-hero .book-overview-cover {
    width: min(100%, 250px);
    margin: 0 auto;
  }

  .book-overview-hero p:first-child {
    margin-top: 0;
  }

  .book-overview-hero p {
    margin-bottom: 1.25rem;
  }

  .book-overview-hero p:last-child {
    margin-bottom: 0;
  }

  .book-overview-question {
    color: var(--foreground) !important;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
  }

  .book-overview-quotes {
    display: grid;
    width: 100%;
    max-width: 64rem;
    gap: 1rem;
    margin-inline: auto;
  }

  .book-overview-quotes blockquote {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--muted);
    padding: 1.25rem;
  }

  .book-overview-quotes blockquote p {
    margin: 0;
    color: var(--foreground);
    font-family: "Fraunces", Georgia, serif;
    font-size: 1.2rem;
    font-style: italic;
  }

  .book-overview-quotes cite {
    display: block;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    font-style: normal;
  }

  .book-overview-button {
    display: inline-block;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-foreground) !important;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .book-overview-button:hover {
    filter: brightness(0.95);
  }

  .book-overview-book-club-link {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }

  .book-overview-bulk {
    margin: 2rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  @media (min-width: 700px) {
    .book-overview-quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .book-overview-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
